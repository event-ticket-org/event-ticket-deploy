# The template for .env. `./build.sh` copies it and fills in the four secrets; copy it by hand
# if you would rather choose them yourself.
#
# Named without a leading dot on purpose - a committed `.env.something` is the file people
# reach for when they want real values, and this one must never hold any.
#
# .env itself is gitignored. Nothing in it belongs in this repository, which is what separates
# it from event-ticket-backend/src/main/resources/application-dev.yml: that file is committed
# deliberately, because a published credential is safe exactly as long as it can only ever be
# used locally.

# ---- where the application is reached ----
# The port the whole product answers on. Every emailed link is built from it, so changing it
# after people hold tickets breaks their links.
APP_PORT=8081
# The object store's published port. The browser posts covers here and fetches them here.
STORAGE_PORT=9000

# ---- images ----
BACKEND_IMAGE=event-ticket-backend:local
FRONTEND_IMAGE=event-ticket-frontend:local
# Baked into the frontend image at build time, so changing it means running ./build.sh again.
# FAKE or STRIPE.
VITE_PAYMENT_PROVIDER=FAKE

# ---- database ----
# The database runs on the host, not in this stack - see the README. host.docker.internal is
# how a container reaches it; a managed database elsewhere would be its hostname instead.
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5433
DATABASE_NAME=eventticket
DATABASE_USERNAME=eventticket
DATABASE_PASSWORD=

# ---- secrets ----
# Signs the access tokens. Losing it signs everybody out; leaking it lets anybody in.
JWT_SECRET=
# The MAC over every ticket code, and the heavy one. Nothing that grants entry is stored, so a
# leaked database is not a set of working tickets - this key is what makes that true. Losing it
# makes every outstanding ticket unverifiable, which is a worse day than losing JWT_SECRET.
TICKET_CODE_KEY=
# Signs the fake provider's webhooks, and a webhook is what marks an order paid. Anybody who
# knows it can mint paid orders, so it is a secret even though the provider is a stand-in.
FAKE_PAYMENT_SECRET=

# ---- object storage ----
STORAGE_BUCKET=event-ticket-covers
STORAGE_REGION=ap-southeast-1
STORAGE_ACCESS_KEY=eventticket
STORAGE_SECRET_KEY=

# ---- platform admin ----
# Comma-separated. An account named here is promoted when it registers, and at start-up if it
# registered already. This is the only way to become a platform admin and the only privilege no
# request can grant, so conferring it needs access to the deployment rather than to the product.
PLATFORM_ADMIN_EMAILS=

# ---- Stripe (optional) ----
# Empty means there is no Stripe provider at all, which is what a deployment with no account
# wants - not a provider that fails on first use. The webhook secret comes from wherever events
# are forwarded from: `stripe listen` for a laptop, the dashboard for a reachable deployment.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
